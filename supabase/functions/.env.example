# Local Supabase Edge Function development only.
# Never commit real values. Hosted secrets are configured with `supabase secrets set`.

MARKETING_FUNCTION_SECRET=replace-with-a-long-random-secret
NOTIFICATION_FUNCTION_SECRET=replace-with-a-different-long-random-secret
REMINDER_FUNCTION_SECRET=replace-with-another-long-random-secret
APP_PUBLIC_URL=https://your-velliqo-domain.example

# Resend email delivery
RESEND_API_KEY=re_xxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxx
EMAIL_FROM=Velliqo <notifications@your-verified-domain.example>
MARKETING_TEST_EMAIL=owner-test@example.com

# Twilio SMS delivery (optional)
TWILIO_ACCOUNT_SID=ACxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxx
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxx
# Use TWILIO_FROM_NUMBER instead when no Messaging Service is configured.
TWILIO_FROM_NUMBER=+35700000000
TWILIO_STATUS_CALLBACK_URL=https://PROJECT_REF.supabase.co/functions/v1/twilio-marketing-webhook
# Transactional appointment/reminder SMS status callbacks may use the same verified endpoint.
TRANSACTIONAL_TWILIO_STATUS_CALLBACK_URL=https://PROJECT_REF.supabase.co/functions/v1/twilio-marketing-webhook
MARKETING_TEST_PHONE=+35700000000

# Supabase Vault values used by migration 00050 (configure in Dashboard, not here):
# velliqo_communications_enabled=false
# velliqo_appointment_notification_worker_url=https://PROJECT_REF.supabase.co/functions/v1/process_appointment_notifications
# velliqo_reminder_worker_url=https://PROJECT_REF.supabase.co/functions/v1/process_reminder_jobs
# velliqo_notification_function_secret=<same value as NOTIFICATION_FUNCTION_SECRET>
# velliqo_reminder_function_secret=<same value as REMINDER_FUNCTION_SECRET>
